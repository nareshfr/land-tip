# UrbanAlpha environment configuration. Copy to .env and edit.

# Database. Leave unset to use the in-memory store (default; no Postgres needed).
# For PostGIS persistence set, e.g.:
# DATABASE_URL=postgresql+psycopg2://urbanalpha:urbanalpha@localhost:5432/urbanalpha
DATABASE_URL=

# Baseline valuation model artifacts (relative to project root).
BASELINE_MODEL_PATH=catboost_house_price_model.cbm
BASELINE_METADATA_PATH=preprocessor_metadata.json
BASELINE_CSV_PATH=bengaluru_house_prices.csv

# Simulation defaults.
SIMULATION_YEARS=5

# Scraping cluster.
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_USER_AGENT="UrbanAlpha-GeoAI-Research-Bot/1.0"
SCRAPE_ENABLED=true
# When true, the scraper hits live external URLs. When false, it uses bundled
# offline fixtures (useful for tests and air-gapped runs).
SCRAPE_LIVE=false
